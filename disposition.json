{
  "$schema": "./schemas/disposition.schema.json",
  "elements": {
    "captor": {
      "type": "Captor"
    },
    "combination1": {
      "type": "Combination",
      "references": [
        "coupler1",
        "coupler2",
        "range",
        "action"
      ]
    },
    "combination2": {
      "type": "Combination",
      "references": [
        "coupler1",
        "coupler2",
        "range",
        "action"
      ]
    },
    "roller":{
      "type": "Roller",
      "min": 0,
      "max": 1,
      "references": [
        "combination1",
        "combination2"
      ]
    },
    "console1": {
      "type": "MidiConsole",
      "references": [
        "coupler1",
        "coupler2",
        "range",
        "action",
        "combination1",
        "combination2",
        "captor"
      ]
    },
    "console2": {
      "type": "RestConsole"
    },
    "console3": {
      "type": "TermConsole"
    },
    "magnets": {
      "type": "MagnetReleaser",
      "delay": 500
    },
    "coupler1": {
      "type": "Coupler",
      "transpose": 0,
      "references": [
        "rank1"
      ]
    },
    "coupler2": {
      "type": "Coupler",
      "transpose": 0,
      "references": [
        "rank2"
      ]
    },
    "range": {
      "type": "MidiRange",
      "min": 16,
      "max": 127,
      "change": [
        [
          176,
          7,
          255
        ]
      ],
      "references": [
        "action"
      ]
    },
    "action": {
      "type": "MidiAction",
      "engage": [
        [
          176,
          1,
          64
        ]
      ],
      "disengage": [
        [
          176,
          1,
          0
        ]
      ],
      "references": [
        "sound1"
      ]
    },
    "keyboard1": {
      "type": "MidiKeyboard",
      "references": [
        "coupler1",
        "coupler2"
      ]
    },
    "memory": {
      "type": "Memory",
      "min": 0,
      "max": 64,
      "state": "memory.json"
    },
    "rank1": {
      "type": "MidiRank",
      "references": [
        "range"
      ],
      "acquire": [
        [
          192,
          0,
          0
        ]
      ],
      "release": [
        [
          176,
          121,
          0
        ]
      ]
    },
    "rank2": {
      "type": "MidiRank",
      "references": [
        "range"
      ],
      "acquire": [
        [
          192,
          1,
          0
        ]
      ],
      "release": [
        [
          176,
          121,
          0
        ]
      ]
    },
    "sound1": {
      "type": "FluidsynthSound",
      "soundfont": "./soundfont/disposition.sf2",
      "bank_offset": 0,
      "gain": 0.25,
      "interpolate": 4,
      "settings": {
        "synth_overflow_age": 0.55,
        "synth_overflow_percussion": 0.1,
        "synth_overflow_released": 0.5,
        "synth_overflow_sustained": 0.1,
        "synth_overflow_volume": 0.5,
        "synth_sample_rate": 44100.0,
        "synth_cpu_cores": 4,
        "synth_midi_channels": 128,
        "synth_polyphony": 640,
        "synth_reverb_active": 1,
        "synth_reverb_damp": 0.4,
        "synth_reverb_level": 0.65,
        "synth_reverb_width": 90.0,
        "synth_reverb_room_size": 0.75,
        "audio_periods": 8,
        "audio_period_size": 512
      }
    }
  }
}