{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disposition",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "elements": {
      "type": "object",
      "patternProperties": {
        "^\\S+$": {
          "$ref": "#/$defs/Element"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "elements"
  ],
  "$defs": {
    "Element": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Coupler"
            }
          },
          "$ref": "#/$defs/Coupler",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Captor"
            }
          },
          "$ref": "#/$defs/Captor",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Combination"
            }
          },
          "$ref": "#/$defs/Combination",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Roller"
            }
          },
          "$ref": "#/$defs/Roller",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Memory"
            }
          },
          "$ref": "#/$defs/Memory",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "RestConsole"
            }
          },
          "$ref": "#/$defs/RestConsole",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "TermConsole"
            }
          },
          "$ref": "#/$defs/TermConsole",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MagnetReleaser"
            }
          },
          "$ref": "#/$defs/MagnetReleaser",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MidiConsole"
            }
          },
          "$ref": "#/$defs/MidiConsole",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MidiKeyboard"
            }
          },
          "$ref": "#/$defs/MidiKeyboard",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MidiRank"
            }
          },
          "$ref": "#/$defs/MidiRank",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MidiRange"
            }
          },
          "$ref": "#/$defs/MidiRange",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MidiAction"
            }
          },
          "$ref": "#/$defs/MidiAction",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MidiSound"
            }
          },
          "$ref": "#/$defs/MidiSound",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "FluidsynthSound"
            }
          },
          "$ref": "#/$defs/FluidsynthSound",
          "required": [
            "type"
          ]
        }
      ]
    },
    "MidiSwitchBinding": {
      "type": "object",
      "properties": {
        "activate": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          },
          "default": []
        },
        "deactivate": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          },
          "default": []
        }
      }
    },
    "TermSwitchBinding": {
      "type": "object",
      "properties": {
        "activate": {
          "type": "string"
        },
        "deactivate": {
          "type": "string"
        }
      },
      "required": [
        "activate",
        "deactivate"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "Coupler": {
      "description": "When activated, forwards all key presses to referenced elements.",
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "default": false
        },
        "transpose": {
          "type": "integer",
          "format": "int8",
          "minimum": -128,
          "maximum": 127,
          "default": 0
        },
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "magnet_release_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        }
      }
    },
    "Captor": {
      "description": "When activated, the next activated combination will record its state rather than recalling it.",
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "default": false
        },
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "magnet_release_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CombinationCapture": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ]
    },
    "Combination": {
      "description": "When activated, recalls the state of all references elements.",
      "type": "object",
      "properties": {
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        },
        "state": {
          "type": "object",
          "patternProperties": {
            "^\\S+$": {
              "$ref": "#/$defs/CombinationCapture"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      }
    },
    "TermContinuousBinding": {
      "type": "object",
      "properties": {
        "increase": {
          "type": "string"
        },
        "decrease": {
          "type": "string"
        },
        "delta": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "increase",
        "decrease",
        "delta"
      ]
    },
    "MidiContinuousBinding": {
      "type": "object",
      "properties": {
        "change": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          },
          "default": []
        }
      }
    },
    "Roller": {
      "description": "When its value changes, the element matching the previous value is deactivated,\n and the element matching the new value is activated.",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "Memory": {
      "description": "When its value changes, stores the state of referenced combinations in a matching level.",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "default": "memory.json"
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "RestConsole": {
      "type": "object",
      "properties": {
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "TermConsole": {
      "type": "object"
    },
    "MagnetReleaser": {
      "type": "object",
      "properties": {
        "delay": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        }
      }
    },
    "MidiConsole": {
      "type": "object",
      "properties": {
        "port": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        }
      }
    },
    "MidiKeyboardBinding": {
      "type": "object",
      "properties": {
        "down": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          },
          "default": []
        },
        "up": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          },
          "default": []
        }
      }
    },
    "MidiKeyboard": {
      "type": "object",
      "properties": {
        "port": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiKeyboardBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        }
      }
    },
    "MidiRank": {
      "type": "object",
      "properties": {
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        },
        "acquire": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "release": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      },
      "required": [
        "acquire",
        "release"
      ]
    },
    "MidiRange": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "change": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiContinuousBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        }
      },
      "required": [
        "min",
        "max",
        "change"
      ]
    },
    "MidiAction": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "default": false
        },
        "engage": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "disengage": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "term_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_in_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "console_out_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "magnet_release_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MidiSwitchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "default": []
        }
      },
      "required": [
        "engage",
        "disengage"
      ]
    },
    "MidiSound": {
      "description": "Forwards all MIDI out messages to an arbitrary MIDI device.",
      "type": "object",
      "properties": {
        "port": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "FluidsynthSettings": {
      "type": "object",
      "properties": {
        "synth_overflow_age": {
          "type": "number",
          "format": "double"
        },
        "synth_overflow_percussion": {
          "type": "number",
          "format": "double"
        },
        "synth_overflow_released": {
          "type": "number",
          "format": "double"
        },
        "synth_overflow_sustained": {
          "type": "number",
          "format": "double"
        },
        "synth_overflow_volume": {
          "type": "number",
          "format": "double"
        },
        "synth_sample_rate": {
          "type": "number",
          "format": "double"
        },
        "synth_cpu_cores": {
          "type": "integer",
          "format": "int32"
        },
        "synth_midi_channels": {
          "type": "integer",
          "format": "int32"
        },
        "synth_polyphony": {
          "type": "integer",
          "format": "int32"
        },
        "synth_reverb_active": {
          "type": "integer",
          "format": "int32"
        },
        "synth_reverb_damp": {
          "type": "number",
          "format": "double"
        },
        "synth_reverb_level": {
          "type": "number",
          "format": "double"
        },
        "synth_reverb_width": {
          "type": "number",
          "format": "double"
        },
        "synth_reverb_room_size": {
          "type": "number",
          "format": "double"
        },
        "audio_periods": {
          "type": "integer",
          "format": "int32"
        },
        "audio_period_size": {
          "type": "integer",
          "format": "int32"
        },
        "audio_driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_device": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "synth_overflow_age",
        "synth_overflow_percussion",
        "synth_overflow_released",
        "synth_overflow_sustained",
        "synth_overflow_volume",
        "synth_sample_rate",
        "synth_cpu_cores",
        "synth_midi_channels",
        "synth_polyphony",
        "synth_reverb_active",
        "synth_reverb_damp",
        "synth_reverb_level",
        "synth_reverb_width",
        "synth_reverb_room_size",
        "audio_periods",
        "audio_period_size"
      ]
    },
    "FluidsynthSound": {
      "description": "Forwards all Midi out messages to a Fluidsynth instance.",
      "type": "object",
      "properties": {
        "soundfont": {
          "type": "string",
          "default": "disposition.sf2"
        },
        "bank_offset": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "gain": {
          "type": "number",
          "format": "float"
        },
        "interpolate": {
          "type": "integer",
          "format": "int32"
        },
        "settings": {
          "$ref": "#/$defs/FluidsynthSettings"
        }
      },
      "required": [
        "gain",
        "interpolate",
        "settings"
      ]
    }
  }
}